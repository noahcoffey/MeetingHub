    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^3.0.3",
