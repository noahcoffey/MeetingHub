# PostgreSQL connection string
DATABASE_URL=postgres://meetinghub:meetinghub@localhost:5432/meetinghub

# Auth.js session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Seeded single user (created on first `npm run db:seed`)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me

# LEGACY — calendar feeds are per-workspace settings now (Settings -> Workspaces).
# If set, db:migrate adopts this URL into the default workspace's ics_url once
# (only while that field is empty); after that the var can be removed.
CALENDAR_ICS_URL=

# IANA timezone used for "today" and day-boundary math. Defaults to America/New_York.
APP_TIMEZONE=America/New_York

# Number of trusted reverse proxies in front of the app (each appends the client
# IP to X-Forwarded-For). Used to derive the real client IP for login throttling.
# Default 1 (a single proxy such as Traefik). Set to 0 if the app is exposed
# directly with no proxy (then XFF is untrusted and per-IP throttling degrades to
# the global backstop). See SECURITY.md.
# TRUSTED_PROXY_COUNT=1

# Optional: Google Calendar import. Create an OAuth 2.0 Client (type "Web
# application") in Google Cloud, enable the Calendar API, and add the redirect
# URI https://<your-host>/api/calendar/google/callback. Then connect accounts
# under Settings -> Calendars. Leave blank to use only .ics feeds.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if your redirect URI differs from ${origin}/api/calendar/google/callback
# GOOGLE_REDIRECT_URI=

# Optional: Google Drive files (same OAuth client as above). Additionally enable
# the Drive API in the Google Cloud project and register a second redirect URI
# https://<your-host>/api/drive/google/callback, then connect under
# Settings -> Drive files. The app only ever sees files it created itself
# (drive.file scope), all inside a MeetingHub folder it makes in Drive root.
# Optional override if your redirect URI differs from ${origin}/api/drive/google/callback
# GOOGLE_DRIVE_REDIRECT_URI=
# Max upload size in MB (default 25). Uploads are buffered in memory and proxied
# to Drive server-side; if a reverse proxy in front of the app enforces its own
# request-body limit, raise that too.
# DRIVE_MAX_UPLOAD_MB=25

# Bearer token an external client uses to push generated notes to POST /api/ingest
INGEST_API_KEY=
# Optional: max /api/ingest request body in KB (default 5120 = 5 MB). Raise if you
# ever push very large payloads (e.g. full transcripts).
# INGEST_MAX_BODY_KB=5120
